<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml
  The "table of contents" for the Android app. Every Activity,
  Service, BroadcastReceiver, and permission must be declared here.
  Android reads this file to know what components exist before
  it ever runs any of your code.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: required to make network calls to the Battalion API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- RECEIVE_BOOT_COMPLETED: lets us reschedule the widget alarm after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BattalionCompanion"
        android:usesCleartextTraffic="false">

        <!--
          LoginActivity: the entry point of the app (MAIN + LAUNCHER).
          This is the first screen shown when the user taps the app icon.
          It immediately redirects to MainActivity if already logged in.
        -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          MainActivity: the main content screen (stats, emotions, actions).
          Not exported — only accessible from within the app or from the widget.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!--
          BattalionWidget: the home screen widget.

          CONCEPT: A widget is an AppWidgetProvider, which is a special
          BroadcastReceiver. Android sends it broadcasts for events like
          "update now", "widget added", "widget removed".

          The intent-filter for APPWIDGET_UPDATE is what makes Android
          recognize this class as a widget provider.

          android:meta-data points to battalion_widget_info.xml which
          tells the launcher the widget's size and update frequency.
        -->
        <receiver
            android:name=".BattalionWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jeffersonwm.battalion.CYCLE_STAT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battalion_widget_info" />
        </receiver>

        <!-- StatsWidgetConfigActivity: display settings for stats widget -->
        <activity
            android:name=".StatsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.BattalionCompanion">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- ShortcutWidgetConfigActivity: configures action/emotion for 1x1 shortcut widget -->
        <activity
            android:name=".ShortcutWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.BattalionCompanion">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- ShortcutActionDialogActivity: Android confirmation dialog when shortcut widget is pressed -->
        <activity
            android:name=".ShortcutActionDialogActivity"
            android:exported="false"
            android:theme="@style/Theme.BattalionCompanion.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- BattalionShortcutWidget: 1x1 one-tap widget for any action or emotion -->
        <receiver
            android:name=".BattalionShortcutWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jeffersonwm.battalion.TRIGGER_SHORTCUT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battalion_shortcut_widget_info" />
        </receiver>

    </application>

</manifest>
