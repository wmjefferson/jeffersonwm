{
  "name": "battalion",
  "version": "1.2.35",
  "private": true,
  "description": "Battalion - A gamified life-tracker RPG",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd backend && node --watch index.js",
    "dev:client": "cd client && npx vite --host",
    "setup": "cd backend && node db/seed.js && node ..\\..\\scripts\\finish-stamp.mjs --label \"setup\"",
    "build": "cd client && npx vite build && node ..\\..\\scripts\\finish-stamp.mjs --label \"build\"",
    "server": "cd backend && node index.js",
    "start": "cd backend && node index.js",
    "prod": "set NODE_ENV=production && cd backend && node index.js",
    "tunnel": "cloudflared tunnel run --token %BATALLION_TUNNEL_TOKEN% && node ..\\..\\scripts\\finish-stamp.mjs --label \"tunnel\"",
    "publish": "node ..\\..\\scripts\\publish-aso.mjs --app battalion && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish\"",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "npm version patch --no-git-tag-version && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch\"",
    "version:minor": "npm version minor --no-git-tag-version && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor\"",
    "version:major": "npm version major --no-git-tag-version && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "vite": "^6.3.0"
  }
}
