@page
@using System.Text.Json
@model LibraryScanner.Web.Pages.Books.BulkModel
@{
    ViewData["Title"] = "Bulk tools";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<p class="bulk-status-row" aria-label="Bulk inventory status">
    <span><strong>@Model.TotalTitles</strong> Titles</span>
    <span><strong>@Model.TotalItems</strong> Items</span>
    <span><strong>@Model.TotalTags</strong> Tags</span>
    <span><strong>@Model.TotalCollections</strong> Collections</span>
    <span aria-hidden="true"></span>
</p>

<form method="get" class="toolbar bulk-filter-toolbar">
    <input asp-for="Query" class="form-control" placeholder="Search title, ISBN, author, publisher, tags, collections, status, or location" />
    <select asp-for="TagId" asp-items="Model.TagOptions" class="form-select"></select>
    <select asp-for="CollectionId" asp-items="Model.CollectionOptions" class="form-select"></select>
    <select asp-for="StatusFilter" asp-items="Model.StatusFilterOptions" class="form-select"></select>
    <button class="btn btn-outline-secondary" type="submit">Filter</button>
    <a class="btn btn-outline-secondary" asp-page="/Books/Bulk">Clear</a>
</form>

@if (Model.Books.Count == 0)
{
    <div class="empty-state">
        <h2>No books found</h2>
        <p>Try clearing the filters or return to Inventory to add books first.</p>
        <a class="btn btn-primary" asp-page="/Books/Index">Go to inventory</a>
    </div>
}
else
{
    <form method="post" class="bulk-form">
        <input asp-for="Query" type="hidden" />
        <input asp-for="CollectionId" type="hidden" />
        <input asp-for="TagId" type="hidden" />
        <input asp-for="StatusFilter" type="hidden" />

        <section class="panel bulk-selection-panel" data-bulk-selection-panel>
            <div class="bulk-selection-summary">
                <div>
                    <h2>Selected books</h2>
                    <p class="form-hint">
                        Showing @Model.Books.Count visible books out of @Model.FilteredCount matching the current filters.
                        <span data-selected-count-text>No books selected yet.</span>
                    </p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Tags/Index">Manage tags and collections</a>
            </div>

            <div class="bulk-selection-shared" data-bulk-shared hidden>
                <div>
                    <span class="bulk-shared-label">Shared tags</span>
                    <div class="tag-list" data-shared-tags></div>
                </div>
                <div>
                    <span class="bulk-shared-label">Shared collections</span>
                    <div class="tag-list" data-shared-collections></div>
                </div>
                <div>
                    <span class="bulk-shared-label">Availability</span>
                    <div class="tag-list" data-shared-status></div>
                </div>
                <div>
                    <span class="bulk-shared-label">Location</span>
                    <div class="tag-list" data-shared-location></div>
                </div>
            </div>

            <p class="form-hint bulk-inline-hint" data-bulk-empty-state>Select books in the table below to see their shared tags, collections, availability, and location here.</p>

            <div class="bulk-actions-grid">
                <div class="field-stack">
                    <label asp-for="AddTagNames">Add tags</label>
                    <div class="tag-input-stack" data-live-tag-editor>
                        <input asp-for="AddTagNames" class="form-control" placeholder="tag | note, another tag" data-live-tag-input />
                        <div class="tag-search-results" data-live-tag-results hidden></div>
                    </div>
                    <span class="form-hint">Use commas between tags. Optional format: <code>tag | note</code> for new tag descriptions.</span>
                    <button type="submit" asp-page-handler="AddTags" class="btn btn-primary">Add tags to selected</button>
                </div>

                <div class="field-stack">
                    <label asp-for="RemoveTagNames">Remove tags</label>
                    <div class="tag-input-stack" data-live-tag-editor>
                        <input asp-for="RemoveTagNames" class="form-control" placeholder="hardcover, wishlist" data-live-tag-input />
                        <div class="tag-search-results" data-live-tag-results hidden></div>
                    </div>
                    <span class="form-hint">Live results show your existing tags. Only matching tags on selected books will be removed.</span>
                    <button type="submit" asp-page-handler="RemoveTags" class="btn btn-outline-secondary">Remove tags from selected</button>
                </div>

                <div class="field-stack">
                    <label asp-for="SelectedCollectionId">Add to collection</label>
                    <select asp-for="SelectedCollectionId" asp-items="Model.CollectionOptions.Skip(1)" class="form-select">
                        <option value="">Choose collection</option>
                    </select>
                    <button type="submit" asp-page-handler="AddToCollection" class="btn btn-outline-secondary">Add selected to collection</button>
                </div>

                <div class="field-stack">
                    <label asp-for="SelectedStatus">Set availability</label>
                    <select asp-for="SelectedStatus" asp-items="Model.StatusOptions" class="form-select">
                        <option value="">Choose status</option>
                    </select>
                    <button type="submit" asp-page-handler="SetStatus" class="btn btn-outline-secondary">Apply availability</button>
                </div>

                <div class="field-stack">
                    <label asp-for="SelectedLocationId">Move to location</label>
                    <select asp-for="SelectedLocationId" asp-items="Model.LocationOptions" class="form-select"></select>
                    <button type="submit" asp-page-handler="MoveToLocation" class="btn btn-outline-secondary">Move selected</button>
                </div>
            </div>
        </section>

        <div class="table-wrap">
            <table class="table inventory-table">
                <thead>
                    <tr>
                        <th class="selection-column">
                            <input type="checkbox" data-select-all aria-label="Select all books" />
                        </th>
                        <th>Book</th>
                        <th>ISBN</th>
                        <th>Qty</th>
                        <th>Collections + tags</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var book in Model.Books)
                {
                    var titleAuthor = string.IsNullOrWhiteSpace(book.Authors) ? book.Title : $"{book.Title} - {book.Authors}";
                    <tr>
                        <td class="selection-column">
                            <input type="checkbox" name="SelectedBookIds" value="@book.Id" data-select-item data-book-id="@book.Id" aria-label="Select @book.Title" />
                        </td>
                        <td>
                            <div class="book-cell">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl" alt="" />
                                }
                                else
                                {
                                    <div class="cover-placeholder"></div>
                                }
                                <div>
                                    <div class="copy-line">
                                        <a class="book-title-link" asp-page="/Books/Edit" asp-route-id="@book.Id"><strong>@book.Title</strong></a>
                                        <button type="button" class="copy-button" data-copy-text="@titleAuthor" title="Copy title and author" aria-label="Copy title and author"><span class="copy-icon" aria-hidden="true"></span></button>
                                    </div>
                                    <span>@book.Authors</span>
                                    @if (!string.IsNullOrWhiteSpace(book.Publisher))
                                    {
                                        <small>@book.Publisher @book.PublishedDate</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="copy-line">
                                <span>@book.Isbn13</span>
                                <button type="button" class="copy-button" data-copy-text="@book.Isbn13" title="Copy ISBN" aria-label="Copy ISBN"><span class="copy-icon" aria-hidden="true"></span></button>
                            </div>
                        </td>
                        <td>@book.EffectiveQuantity</td>
                        <td>
                            <div class="tag-list tag-list--metadata">
                                @foreach (var collectionBook in book.CollectionBooks.OrderBy(item => item.Collection.Name))
                                {
                                    <span class="collection-pill">@collectionBook.Collection.Name</span>
                                }
                                @foreach (var bookTag in book.BookTags.OrderBy(bookTag => bookTag.Tag.Name))
                                {
                                    <span class="tag-pill" style="--tag-color:@bookTag.Tag.Color">@bookTag.Tag.Name</span>
                                }
                            </div>
                        </td>
                        <td><span class="status-pill">@book.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>
}

<script id="bulk-selection-data" type="application/json">
@Html.Raw(JsonSerializer.Serialize(Model.SelectableBooks))
</script>

<script id="tag-data" type="application/json">
@Html.Raw(JsonSerializer.Serialize(Model.AvailableTags))
</script>
