@page
@model LibraryScanner.Web.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Inventory";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<p class="inventory-status-row" aria-label="Inventory status">
    <span><strong>@Model.TotalTitles</strong> Titles</span>
    <span><strong>@Model.TotalQuantity</strong> Items</span>
    <span><strong>@Model.TotalTags</strong> Tags</span>
    <span><strong>@Model.TotalCollections</strong> Collections</span>
    <span class="status-row-action-cell"><a class="btn btn-primary status-row-action" asp-page="/Books/Create">Add book</a></span>
</p>

<form method="get" class="inventory-filter-form" data-inventory-filter-form>
    <input asp-for="Sort" type="hidden" data-inventory-sort-value />
    <input asp-for="PageNumber" type="hidden" value="1" data-inventory-page-number />
    <div class="inventory-search-row">
        <input asp-for="Query" class="form-control" placeholder="Search ISBN, title, author, publisher, tags, collections, location, notes" data-inventory-query />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        <button class="btn btn-outline-secondary" type="button" data-inventory-filter-clear>Clear</button>
        <div class="inventory-filter-menu" data-inventory-filter-menu>
            <button class="btn btn-outline-secondary" type="button" aria-expanded="false" data-inventory-filter-toggle>Filter</button>
            <div class="inventory-filter-popover" hidden data-inventory-filter-popover>
                <div class="inventory-filter-popover-header">
                    <strong>Inventory Filters</strong>
                    <span data-inventory-filter-count>@Model.FilteredCount shown</span>
                </div>
                <section class="inventory-filter-group">
                    <h2>Sort</h2>
                    <div class="inventory-filter-options">
                    @foreach (var option in Model.SortOptions)
                    {
                        var isSortSelected = Model.Sort?.StartsWith(option.Value!) == true;
                        <button class="inventory-filter-option @(isSortSelected ? "is-active" : string.Empty)" type="button" aria-pressed="@isSortSelected.ToString().ToLowerInvariant()" data-inventory-sort-option data-sort="@option.Value" data-sort-label="@option.Text">@option.Text@(Model.Sort == $"{option.Value}_desc" ? " ↓" : Model.Sort == option.Value ? " ↑" : string.Empty)</button>
                    }
                    </div>
                </section>
                <section class="inventory-filter-group">
                    <h2>Collections</h2>
                    <div class="inventory-filter-options">
                    @foreach (var option in Model.CollectionFilters)
                    {
                        var isSelected = Model.CollectionIds.Contains(option.Id);
                        <label class="inventory-filter-check @(isSelected ? "is-active" : string.Empty)" role="button" aria-pressed="@isSelected.ToString().ToLowerInvariant()" data-inventory-toggle-label>
                            <input type="checkbox" name="CollectionIds" value="@option.Id" checked="@isSelected" />
                            <span>@option.Name</span>
                            <span class="inventory-filter-count">@option.Count</span>
                        </label>
                    }
                    </div>
                </section>
                <section class="inventory-filter-group">
                    <h2>Tags</h2>
                    <div class="inventory-filter-options">
                    @foreach (var option in Model.TagFilters)
                    {
                        var isSelected = Model.TagIds.Contains(option.Id);
                        <label class="inventory-filter-check @(isSelected ? "is-active" : string.Empty)" role="button" aria-pressed="@isSelected.ToString().ToLowerInvariant()" data-inventory-toggle-label>
                            <input type="checkbox" name="TagIds" value="@option.Id" checked="@isSelected" />
                            <span>@option.Name</span>
                            <span class="inventory-filter-count">@option.Count</span>
                        </label>
                    }
                    </div>
                </section>
                <section class="inventory-filter-group">
                    <h2>Locations</h2>
                    <div class="inventory-filter-options">
                    @foreach (var option in Model.LocationFilters)
                    {
                        var isSelected = Model.LocationIds.Contains(option.Id);
                        <label class="inventory-filter-check @(isSelected ? "is-active" : string.Empty)" role="button" aria-pressed="@isSelected.ToString().ToLowerInvariant()" data-inventory-toggle-label>
                            <input type="checkbox" name="LocationIds" value="@option.Id" checked="@isSelected" />
                            <span>@option.Name</span>
                            <span class="inventory-filter-count">@option.Count</span>
                        </label>
                    }
                    </div>
                </section>
                <section class="inventory-filter-group">
                    <h2>Availability</h2>
                    <div class="inventory-filter-options">
                    @foreach (var option in Model.StatusFilters)
                    {
                        var isSelected = Model.Statuses.Contains(option.Id, StringComparer.OrdinalIgnoreCase);
                        <label class="inventory-filter-check @(isSelected ? "is-active" : string.Empty)" role="button" aria-pressed="@isSelected.ToString().ToLowerInvariant()" data-inventory-toggle-label>
                            <input type="checkbox" name="Statuses" value="@option.Id" checked="@isSelected" />
                            <span>@option.Name</span>
                            <span class="inventory-filter-count">@option.Count</span>
                        </label>
                    }
                    </div>
                </section>
                <div class="inventory-filter-actions">
                    <button class="btn btn-primary" type="submit">Apply filters</button>
                </div>
            </div>
        </div>
        <label class="inventory-page-size">
            <span>Entries</span>
            <select asp-for="PageSize" asp-items="Model.PageSizeOptions" class="form-select" data-inventory-page-size></select>
        </label>
    </div>
</form>

@if (Model.Books.Count == 0)
{
    <div class="empty-state">
        <h2>No books found</h2>
        <p>Add a book or clear the search to see the full inventory.</p>
        <a class="btn btn-primary" asp-page="/Books/Create">Add book</a>
    </div>
}
else
{
    <div class="table-wrap">
            <table class="table inventory-table">
                <thead>
                    <tr>
                        <th class="selection-column">
                            <input type="checkbox" data-select-all aria-label="Select all books" />
                        </th>
                        <th>Book</th>
                        <th>ISBN</th>
                        <th>Qty</th>
                        <th>Collections + tags</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody data-inventory-table-body>
                @foreach (var book in Model.Books)
                {
                    var titleAuthor = string.IsNullOrWhiteSpace(book.Authors) ? book.Title : $"{book.Title} - {book.Authors}";
                    <tr>
                        <td class="selection-column">
                            <input type="checkbox" name="SelectedBookIds" value="@book.Id" data-select-item aria-label="Select @book.Title" />
                        </td>
                        <td>
                            <div class="book-cell">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl" alt="" />
                                }
                                else
                                {
                                    <div class="cover-placeholder"></div>
                                }
                                <div>
                                    <div class="copy-line">
                                        <a class="book-title-link" asp-page="/Books/Edit" asp-route-id="@book.Id"><strong>@book.Title</strong></a>
                                        <button type="button" class="copy-button" data-copy-text="@titleAuthor" title="Copy title and author" aria-label="Copy title and author"><span class="copy-icon" aria-hidden="true"></span></button>
                                    </div>
                                    <span>@book.Authors</span>
                                    @if (!string.IsNullOrWhiteSpace(book.Publisher))
                                    {
                                        <small>@book.Publisher @book.PublishedDate</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="copy-line">
                                <span>@book.Isbn13</span>
                                <button type="button" class="copy-button" data-copy-text="@book.Isbn13" title="Copy ISBN" aria-label="Copy ISBN"><span class="copy-icon" aria-hidden="true"></span></button>
                            </div>
                        </td>
                        <td>@book.EffectiveQuantity</td>
                        <td>
                            <div class="tag-list tag-list--metadata">
                                @foreach (var collectionBook in book.CollectionBooks.OrderBy(item => item.Collection.Name))
                                {
                                    <span class="collection-pill">@collectionBook.Collection.Name</span>
                                }
                                @foreach (var bookTag in book.BookTags.OrderBy(bookTag => bookTag.Tag.Name))
                                {
                                    <span class="tag-pill" style="--tag-color:@bookTag.Tag.Color">@bookTag.Tag.Name</span>
                                }
                            </div>
                        </td>
                        <td><span class="status-pill">@book.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
    </div>

    <div class="pager @(Model.TotalPages > 1 ? string.Empty : "is-hidden")" data-inventory-pager>
        <span class="form-hint" data-inventory-page-summary>Page @Model.PageNumber of @Model.TotalPages · @Model.FilteredCount books</span>
        <div class="pager-actions">
            <button class="btn btn-outline-secondary" type="button" data-inventory-page-previous @(Model.PageNumber <= 1 ? "disabled" : null)>Previous</button>
            <button class="btn btn-outline-secondary" type="button" data-inventory-page-next @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)>Next</button>
        </div>
    </div>
}
