                                <input asp-for="LogEndDate" type="date" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary">Export log CSV</button>
                </form>
                *@

                @*
                Import is paused while account-level inventory separation is settling.
                Keep this form here so it can be restored without rebuilding the import handler.
                *@
            </div>
        </div>
    </details>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
