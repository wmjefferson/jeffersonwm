@page "/Control"
@model LibraryScanner.Web.Pages.Users.AdminModel
@{
    ViewData["Title"] = "Control";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<section class="peri-page-shell" data-page-tabs>
    <header class="peri-page-header">
        <div>
            <h1>Control</h1>
            <p>Manage inventory labels, groupings, and physical locations</p>
        </div>
    </header>

    <nav class="peri-page-tabs" aria-label="Control sections">
        <button type="button" class="peri-page-tab is-active" data-page-tab="tags" aria-pressed="true">Tags (@Model.Tags.Count)</button>
        <button type="button" class="peri-page-tab" data-page-tab="collections" aria-pressed="false">Collections (@Model.Collections.Count)</button>
        <button type="button" class="peri-page-tab" data-page-tab="locations" aria-pressed="false">Locations (@Model.Locations.Count)</button>
    </nav>

@* App snapshot is intentionally retained for a future Options pass.
<section class="entry-grid">
    <section class="panel">
        <p class="eyebrow">App snapshot</p>
        <h2>Local system</h2>
        <div class="field-stack">
            <div>
                <label>Database path</label>
                <input class="form-control" value="@Model.Snapshot.DatabasePath" readonly />
            </div>
            <div>
                <label>Database updated</label>
                <input class="form-control" value="@(Model.Snapshot.DatabaseLastUpdated?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Unknown")" readonly />
            </div>
            <div>
                <label>Backup directory</label>
                <input class="form-control" value="@Model.Snapshot.BackupDirectory" readonly />
            </div>
            <div>
                <label>Latest backup</label>
                <input class="form-control" value="@(Model.Snapshot.LatestBackupName ?? "No backup found")" readonly />
            </div>
            <div>
                <label>Latest backup updated</label>
                <input class="form-control" value="@(Model.Snapshot.LatestBackupUpdated?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Unknown")" readonly />
            </div>
        </div>
    </section>
</section>
*@

    <section class="peri-tab-panel is-active" data-page-tab-panel="tags">
        <div class="peri-section-heading">
            <h2>Tag Management</h2>
            <p>Create, rename, color, or remove tags across your visible library.</p>
        </div>
        <div class="panel options-panel">
            <form method="post" class="tag-admin-form">
                <input asp-for="NewTag.Name" class="form-control" placeholder="paper | paperback, hard | hardcover" autocomplete="off" />
                <input asp-for="NewTag.Description" class="form-control" placeholder="Optional tag note or meaning" />
                <input asp-for="NewTag.Color" class="form-control color-input" type="color" />
                <button asp-page-handler="CreateTag" class="btn btn-primary">Create tags</button>
            </form>
            <span asp-validation-for="NewTag.Name" class="text-danger"></span>

            <div class="table-wrap">
                <table class="table inventory-table">
                    <thead>
                        <tr>
                            <th>Tag</th>
                            <th>Books</th>
                            <th>Edit</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var tag in Model.Tags)
                    {
                        <tr>
                            <td>
                                <span class="tag-pill" style="--tag-color:@tag.Color" title="@tag.Description">@tag.Name</span>
                                @if (!string.IsNullOrWhiteSpace(tag.Description))
                                {
                                    <span class="muted-block">@tag.Description</span>
                                }
                            </td>
                            <td>@tag.BookCount</td>
                            <td>
                                <form method="post" asp-page-handler="UpdateTag" class="tag-edit-form">
                                    <input name="id" type="hidden" value="@tag.Id" />
                                    <input name="name" class="form-control" value="@tag.Name" />
                                    <input name="description" class="form-control" value="@tag.Description" placeholder="Optional note" />
                                    <input name="color" class="form-control color-input" type="color" value="@tag.Color" />
                                    <button class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteTag">
                                    <input name="id" type="hidden" value="@tag.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="peri-tab-panel" data-page-tab-panel="collections" hidden>
        <div class="peri-section-heading">
            <h2>Collections</h2>
            <p>Create and edit curated groupings that can be opened from Inventory.</p>
        </div>
        <div class="panel options-panel">
            <form method="post" asp-page-handler="CreateCollection" class="inline-form wide-inline-form">
                <input asp-for="NewCollection.Name" class="form-control" placeholder="Collection name" />
                <input asp-for="NewCollection.Description" class="form-control" placeholder="Optional note" />
                <button class="btn btn-primary">Create</button>
            </form>
            <span asp-validation-for="NewCollection.Name" class="text-danger"></span>

            <div class="table-wrap">
                <table class="table inventory-table">
                    <thead>
                        <tr>
                            <th>Collection</th>
                            <th>Books</th>
                            <th>Edit</th>
                            <th>View</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var collection in Model.Collections)
                    {
                        <tr>
                            <td>
                                <strong>@collection.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(collection.Description))
                                {
                                    <span class="muted-block">@collection.Description</span>
                                }
                            </td>
                            <td>@collection.BookCount</td>
                            <td>
                                <form method="post" asp-page-handler="UpdateCollection" class="inline-form wide-inline-form">
                                    <input name="id" type="hidden" value="@collection.Id" />
                                    <input name="name" class="form-control" value="@collection.Name" />
                                    <input name="description" class="form-control" value="@collection.Description" placeholder="Optional note" />
                                    <button class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Books/Index" asp-route-collectionIds="@collection.Id">Open</a>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteCollection">
                                    <input name="id" type="hidden" value="@collection.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="peri-tab-panel" data-page-tab-panel="locations" hidden>
        <div class="peri-section-heading">
            <h2>Locations</h2>
            <p>Maintain shelf, box, room, or other location names used by book entries and copies.</p>
        </div>
        <div class="panel options-panel">
            <form method="post" asp-page-handler="CreateLocation" class="inline-form wide-inline-form">
                <input asp-for="NewLocation.Name" class="form-control" placeholder="Location name" />
                <input asp-for="NewLocation.Description" class="form-control" placeholder="Optional note" />
                <button class="btn btn-primary">Create</button>
            </form>
            <span asp-validation-for="NewLocation.Name" class="text-danger"></span>

            <div class="table-wrap">
                <table class="table inventory-table">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Books</th>
                            <th>Edit</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var location in Model.Locations)
                    {
                        <tr>
                            <td>
                                <strong>@location.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(location.Description))
                                {
                                    <span class="muted-block">@location.Description</span>
                                }
                            </td>
                            <td>@location.BookCount</td>
                            <td>
                                <form method="post" asp-page-handler="UpdateLocation" class="inline-form wide-inline-form">
                                    <input name="id" type="hidden" value="@location.Id" />
                                    <input name="name" class="form-control" value="@location.Name" />
                                    <input name="description" class="form-control" value="@location.Description" placeholder="Optional note" />
                                    <button class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="DeleteLocation">
                                    <input name="id" type="hidden" value="@location.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
