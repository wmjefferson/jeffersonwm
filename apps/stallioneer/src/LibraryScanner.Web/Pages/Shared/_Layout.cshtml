@inject Microsoft.Extensions.Options.IOptions<LibraryScanner.Web.Services.CentralAuthOptions> CentralAuthOptions
@{
    var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? string.Empty;
    string BannerLinkClass(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase)
            ? "page-banner__link is-active"
            : "page-banner__link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stallioneer</title>
    <script type="importmap"></script>
    <script>
        (() => {
            const savedTheme = localStorage.getItem("stallioneer-theme") || "system";
            document.documentElement.dataset.theme = savedTheme;
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Joan&family=Sofia+Sans+Semi+Condensed:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryScanner.Web.styles.css" asp-append-version="true" />
</head>
<body data-stallioneer-auth-base-url="@CentralAuthOptions.Value.AuthBaseUrl.TrimEnd('/')">
    <div class="shell-gutters" aria-hidden="true">
        <div class="shell-gutter shell-gutter--left"></div>
        <div class="shell-gutter shell-gutter--right"></div>
    </div>
    <header class="page-banner page-banner--top">
        <div class="page-banner__inner shell-frame">
            <a class="page-banner__brand" asp-area="" asp-page="/Index">Stallioneer</a>
            <nav class="page-banner__nav" aria-label="Stallioneer pages">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="@BannerLinkClass("/Books/Index")" asp-area="" asp-page="/Books/Index">Inventory</a>
                    @if (User.IsInRole(LibraryScanner.Web.Models.AppRoles.Admin))
                    {
                        <a class="@BannerLinkClass("/Users/Admin")" asp-area="" asp-page="/Users/Admin">Control</a>
                        <a class="@BannerLinkClass("/Users/Options")" asp-area="" asp-page="/Users/Options">Options</a>
                    }
                }
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>
    <div class="shell-frame shell-frame--body">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="page-banner page-banner--bottom">
        <div class="page-banner__inner shell-frame">
            <span aria-hidden="true"></span>
            <p class="page-banner__copyright">
                &copy; 2026
                <a href="https://jeffersonwm.com" class="page-banner__copyright-link page-banner__copyright-link--primary">Jefferson Williams</a>.
                All rights reserved.
                <a href="https://github.com/wmjefferson/jeffersonwm" class="page-banner__copyright-link">GitHub</a>.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
