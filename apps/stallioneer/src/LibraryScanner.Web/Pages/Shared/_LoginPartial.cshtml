@inject LibraryScanner.Web.Services.CentralAuthService CentralAuthService
@{
    var centralStatus = await CentralAuthService.GetStatusAsync(Context);
    var centralUser = centralStatus.HasAccess ? centralStatus.User : null;
    var returnTo = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var accountUrl = centralUser is null
        ? CentralAuthService.BuildAuthHomeUrl(Context.Request, popup: true)
        : (centralUser.IsAdmin || centralUser.IsOwner
            ? $"{CentralAuthService.AuthBaseUrl}/home?returnTo={Uri.EscapeDataString(returnTo)}"
            : "https://jeffersonwm.com/account/");
}

@if (centralUser is not null)
{
    <a class="page-banner__link" href="@accountUrl" target="_blank" rel="noopener noreferrer">@(centralUser.DisplayName ?? centralUser.Username)</a>
    <button type="button" class="page-banner__button" data-stallioneer-auth-sign-out>Sign Out</button>
}
else
{
    <button type="button" class="page-banner__button" data-stallioneer-auth-open>Sign in</button>
}
