# APHELION_PORT: Port used by the backend server process.
APHELION_PORT="8120"

# APHELION_IMAGE_DIRS: Semicolon- or comma-separated image roots tried in order.
# Put the fastest local server path first, then the shared UNC path as fallback.
APHELION_IMAGE_DIRS="E:\\images\\keep;\\\\JEFFERSHIZZLE-D\\Dotcoms E\\images\\keep"

# Shared MySQL connection used by Aphelion card curation.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
APHELION_MYSQL_DATABASE="aphelion_db"

# VITE_APHELION_API_BASE_URL: Public API base used by the browser build.
VITE_APHELION_API_BASE_URL="https://api-aphelion.jeffersonwm.com"

# Central Auth / Multimillion account bridge.
# Public pages can still be viewed, but account actions and admin curation use this session.
APHELION_REQUIRE_AUTH="true"
APHELION_AUTH_BASE_URL="https://auth.jeffersonwm.com"
APHELION_CENTRAL_AUTH_DB_PATH="E:\\auth-jeffersonwm\\backend\\data\\auth-jeffersonwm.sqlite3"
APHELION_CENTRAL_SESSION_COOKIE_NAME="auth_jeffersonwm_session"
APHELION_REQUIRED_APP_MEMBERSHIP="aphelion"

# Optional: set to Auth's AUTH_INTERNAL_LOG_TOKEN to send Aphelion downloads/resets into Auth history + notifications.
APHELION_AUTH_INTERNAL_LOG_TOKEN=""
