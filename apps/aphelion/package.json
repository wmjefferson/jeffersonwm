{
  "name": "aphelion",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "server": "node dist/server.cjs",
    "tunnel:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-tunnel-dev.ps1",
    "tunnel:live": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-tunnel-live.ps1",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "buildlog": "node ..\\..\\scripts\\logged-build.mjs --app aphelion",
    "buildlog:aphelion": "node ..\\..\\scripts\\logged-build.mjs --app aphelion",
    "buildlog:aph": "node ..\\..\\scripts\\logged-build.mjs --app aphelion",
    "logged-build": "node ..\\..\\scripts\\logged-build.mjs --app aphelion",
    "start": "node dist/server.cjs",
    "publish": "node ..\\..\\scripts\\publish-aphelion.mjs",
    "publish:aphelion": "node ..\\..\\scripts\\publish-aphelion.mjs",
    "publish:aph": "node ..\\..\\scripts\\publish-aphelion.mjs",
    "rename:preview": "node scripts/rename-library.mjs --preview",
    "rename:apply": "node scripts/rename-library.mjs --apply",
    "rename:check": "node scripts/rename-library.mjs --preview",
    "rename:sweep": "node scripts/sweep-new.mjs",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch",
    "version:patch:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch",
    "version:patch:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch",
    "version:minor": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor",
    "version:minor:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor",
    "version:minor:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor",
    "version:major": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major",
    "version:major:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major",
    "version:major:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major",
    "versions": "node ..\\..\\scripts\\versions.mjs",
    "jeffvers": "node ..\\..\\scripts\\versions.mjs",
    "jeffvers:log": "node ..\\..\\scripts\\version-log.mjs --app aphelion",
    "jeffvers:aphelion": "node ..\\..\\scripts\\version-log.mjs --app aphelion",
    "jeffvers:aph": "node ..\\..\\scripts\\version-log.mjs --app aphelion",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
