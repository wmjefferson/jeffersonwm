{
  "name": "aphelion",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "server": "node dist/server.cjs",
    "tunnel:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-tunnel-dev.ps1",
    "tunnel:live": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-tunnel-live.ps1",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"build\"",
    "buildlog": "node ..\\..\\scripts\\logged-build.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog\"",
    "buildlog:aphelion": "node ..\\..\\scripts\\logged-build.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog:aphelion\"",
    "buildlog:aph": "node ..\\..\\scripts\\logged-build.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog:aph\"",
    "logged-build": "node ..\\..\\scripts\\logged-build.mjs --app aphelion",
    "start": "node dist/server.cjs",
    "publish": "node ..\\..\\scripts\\publish-aphelion.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish\"",
    "publish:aphelion": "node ..\\..\\scripts\\publish-aphelion.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish:aphelion\"",
    "publish:aph": "node ..\\..\\scripts\\publish-aphelion.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish:aph\"",
    "rename:preview": "node scripts/rename-library.mjs --preview && node ..\\..\\scripts\\finish-stamp.mjs --label \"rename:preview\"",
    "rename:apply": "node scripts/rename-library.mjs --apply && node ..\\..\\scripts\\finish-stamp.mjs --label \"rename:apply\"",
    "rename:check": "node scripts/rename-library.mjs --preview && node ..\\..\\scripts\\finish-stamp.mjs --label \"rename:check\"",
    "rename:sweep": "node scripts/sweep-new.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"rename:sweep\"",
    "count:sync": "node scripts/sync-target-count.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"count:sync\"",
    "count:preview": "node scripts/sync-target-count.mjs --preview && node ..\\..\\scripts\\finish-stamp.mjs --label \"count:preview\"",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch\"",
    "version:patch:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch:aphelion\"",
    "version:patch:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch:aph\"",
    "version:minor": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor\"",
    "version:minor:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor:aphelion\"",
    "version:minor:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor:aph\"",
    "version:major": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major\"",
    "version:major:aphelion": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major:aphelion\"",
    "version:major:aph": "node ..\\..\\scripts\\version-and-log.mjs --app aphelion --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major:aph\"",
    "versions": "node ..\\..\\scripts\\versions.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"versions\"",
    "jeffvers": "node ..\\..\\scripts\\versions.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers\"",
    "jeffvers:log": "node ..\\..\\scripts\\version-log.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:log\"",
    "jeffvers:aphelion": "node ..\\..\\scripts\\version-log.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:aphelion\"",
    "jeffvers:aph": "node ..\\..\\scripts\\version-log.mjs --app aphelion && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:aph\"",
    "preview": "vite preview",
    "lint": "tsc --noEmit && node ..\\..\\scripts\\finish-stamp.mjs --label \"lint\""
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
