<UserControl x:Class="Lionfish.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Listening Mode Banner -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,15" Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎯" FontSize="28" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Identify Mode Active" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                    <TextBlock Text="Press ANY button on your USB keypad or laptop keyboard to instantly highlight and identify it." Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Cancel" Command="{Binding StopListeningCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Normal Header Bar -->
        <Grid Grid.Row="0" Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Connected Keyboards &amp; Keypads" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Identify your keypads and assign roles. The Master Keyboard will always type normally." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button Content="🎯 Identify Device" Command="{Binding StartListeningCommand}" Margin="0,0,10,0" ToolTip="Press a key on any device to find it in the list"/>
                <Button Content="🔄 Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Rescan connected USB and internal keyboards"/>
            </StackPanel>
        </Grid>

        <!-- Device List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource HighlightCardBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Device Category Icon -->
                            <TextBlock Grid.Column="0" Text="{Binding CategoryIcon}" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            
                            <!-- Device Information -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Normal Title View -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="✏️" Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource InlineIconButton}" ToolTip="Edit device title" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    
                                    <!-- Laptop Tag -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Internal Laptop" FontSize="11" Foreground="{DynamicResource SecondaryAccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Renaming Inline Input -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2" Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="250" FontSize="13" Padding="6,4" Margin="0,0,6,0"/>
                                    <Button Content="✓ Save" Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Padding="8,4" Margin="0,0,4,0" ToolTip="Save custom device title"/>
                                    <Button Content="✕" Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}" Padding="8,4" ToolTip="Cancel renaming"/>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding HardwareId}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <!-- Status Badges -->
                                    <Border Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsMaster, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                        <TextBlock Text="🛡️ Master Keyboard (Protected)" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{DynamicResource SecondaryAccentBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsMacroPad, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                        <TextBlock Text="⚡ Macro Pad (Intercepted)" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsUnregistered, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                        <TextBlock Text="Unassigned" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>

                                    <!-- Last Key Pressed Indicator -->
                                    <Border Background="{DynamicResource HighlightCardBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="{Binding LastKeyPressed.Length, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LastKeyPressed, StringFormat='Last key: [{0}]'}" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Role Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Set Master" Command="{Binding DataContext.SetAsMasterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Visibility="{Binding IsMaster, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" ToolTip="Keep this keyboard typing normally"/>
                                <Button Content="Set Macro Pad" Command="{Binding DataContext.RegisterAsMacroPadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,6,0" Visibility="{Binding IsMacroPad, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" ToolTip="Intercept this keypad to trigger macros &amp; shortcuts"/>
                                <Button Content="Unassign" Command="{Binding DataContext.UnregisterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsUnregistered, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status Summary Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryAccentBrush}" 
                           FontWeight="Medium" Margin="0,0,0,8" HorizontalAlignment="Center"
                           Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Master Keyboard: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MasterKeyboard.FriendlyName, TargetNullValue='None (Laptop recommended)'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,25,0"/>
                    <TextBlock Text="Macro Pads Configured: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MacroPadCount}" FontWeight="Bold" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
