<Window x:Class="Lionfish.App.Views.OsdOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lionfish OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="OsdShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.75" Color="#000000"/>
    </Window.Resources>
    
    <Border Margin="10" 
            Background="#E61E1E2E" 
            BorderBrush="#99FF6B35" 
            BorderThickness="1.5" 
            CornerRadius="10" 
            Padding="14,10"
            Effect="{StaticResource OsdShadow}"
            Cursor="SizeAll"
            ToolTip="Lionfish On-Screen Display (Click and drag anywhere to move)">
        <Grid MinWidth="220" MaxWidth="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row with App Title, Drag Grip & Dismiss Button -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🦁" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LIONFISH" FontSize="10" FontWeight="ExtraBold" Foreground="#FF6B35" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" Text="⋮⋮" FontSize="12" Foreground="#55A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Drag to reposition"/>
                
                <Button Grid.Column="3" Click="CloseButton_Click" Style="{x:Null}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Hide OSD (can re-enable from tray or settings)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="5,2">
                                <TextBlock x:Name="Txt" Text="✕" FontSize="10" FontWeight="Bold" Foreground="#88A0A0B0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FF453A"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="#FF453A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Profile Row -->
            <Border Grid.Row="1" Background="#332D2D44" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Profile: " FontSize="11" Foreground="#A0A0B0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveProfileName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Last Action / Button Row -->
            <Border Grid.Row="2" Background="#264ECDC4" BorderBrush="#334ECDC4" BorderThickness="1" CornerRadius="6" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚡ " FontSize="11" Foreground="#4ECDC4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastActionSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0F7F6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
