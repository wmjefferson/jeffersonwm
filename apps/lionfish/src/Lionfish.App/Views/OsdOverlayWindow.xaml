<Window x:Class="Lionfish.App.Views.OsdOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lionfish OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="OsdShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.65" Color="#000000"/>
    </Window.Resources>
    
    <Border Margin="10" 
            Background="#E61E1E2E" 
            BorderBrush="#80FF6B35" 
            BorderThickness="1.5" 
            CornerRadius="10" 
            Padding="12,8"
            Effect="{StaticResource OsdShadow}"
            Cursor="SizeAll"
            ToolTip="Lionfish On-Screen Display (Drag to reposition)">
        <Grid MinWidth="200" MaxWidth="340">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row with App Title & Drag Grip -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🦁" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="LIONFISH" FontSize="9.5" FontWeight="ExtraBold" Foreground="#FF6B35" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="⋮⋮" FontSize="11" Foreground="#66A0A0B0" VerticalAlignment="Center"/>
            </Grid>

            <!-- Profile Row -->
            <Border Grid.Row="1" Background="#332D2D44" CornerRadius="5" Padding="6,4" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Profile: " FontSize="11" Foreground="#A0A0B0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveProfileName}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Last Action / Button Row -->
            <Border Grid.Row="2" Background="#264ECDC4" BorderBrush="#334ECDC4" BorderThickness="1" CornerRadius="5" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚡ " FontSize="11" Foreground="#4ECDC4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastActionSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#E0F7F6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
