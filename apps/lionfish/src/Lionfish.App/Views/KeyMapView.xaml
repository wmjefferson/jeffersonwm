<UserControl x:Class="Lionfish.App.Views.KeyMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Device & Profile Selection -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RegisteredDevices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,16,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource SecondaryAccentBrush}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsMacroPad, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                        <TextBlock Text="Active" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Profile:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    
                    <Grid Grid.Column="3" Margin="0,0,12,0">
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                  Visibility="{Binding IsRenamingProfile, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <TextBox Text="{Binding RenameProfileText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRenamingProfile, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <!-- Normal Buttons -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenamingProfile, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Button Content="✏️ Rename" Command="{Binding StartRenameProfileCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding HasActiveDevices}" Margin="0,0,6,0" ToolTip="Rename current profile"/>
                            <Button Content="+ New Profile" Command="{Binding NewProfileCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding HasActiveDevices}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButton}" IsEnabled="{Binding HasActiveDevices}"/>
                        </StackPanel>
                        <!-- Renaming Buttons -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenamingProfile, Converter={StaticResource BoolToVis}}">
                            <Button Content="✓ Save" Command="{Binding SaveRenameProfileCommand}" Margin="0,0,6,0"/>
                            <Button Content="✕ Cancel" Command="{Binding CancelRenameProfileCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Auto-Switch Target Application -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="🎯 Target App (Auto-Switch):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="(switches to this profile when app focuses)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Text="{Binding SelectedProfile.TargetProcessName, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             ToolTip="Process name without .exe (e.g. opera, chrome, msedge, excel). Leave empty for default profile."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Opera" Command="{Binding SetTargetAppCommand}" CommandParameter="opera" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Set target to Opera browser"/>
                        <Button Content="Chrome" Command="{Binding SetTargetAppCommand}" CommandParameter="chrome" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Set target to Google Chrome"/>
                        <Button Content="Excel" Command="{Binding SetTargetAppCommand}" CommandParameter="excel" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,4,0" ToolTip="Set target to Microsoft Excel"/>
                        <Button Content="Clear" Command="{Binding ClearTargetAppCommand}" Style="{StaticResource SecondaryButton}" Padding="7,2" ToolTip="Clear target app (default profile)"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Row="1">
            <!-- Empty state when no keypad is activated yet -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="30"
                    Visibility="{Binding HasActiveDevices, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="⚡" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Active Keypads" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"
                               FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"/>
                    <TextBlock Text="To assign macros and shortcuts, go to the Devices tab and click 'Activate' on your keypad." 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                </StackPanel>
            </Border>

            <!-- Main Layout when devices are active -->
            <Grid Visibility="{Binding HasActiveDevices, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Key List -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Physical Key" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Assigned Action" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="Action" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ScanCode, StringFormat='{}ScanCode: 0x{0:X2}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ActionAssignment}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccentBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="Edit" Command="{Binding DataContext.EditMappingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="⚡ Add Key (Listen Mode)" Command="{Binding AddMappingCommand}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Editor Panel (Flyout / Right side) -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="12,0,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Edit Key Action" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif" Margin="0,0,0,12"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Key Name & Capture -->
                            <TextBlock Text="Key Display Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedMapping.KeyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                            <!-- Listen Banner -->
                            <Border Background="{DynamicResource HighlightCardBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ListenStatusText}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Visibility="{Binding IsListeningForKey, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Key code captured." Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsListeningForKey, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🎯 Listen" Command="{Binding ListenForKeyCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3"/>
                                </Grid>
                            </Border>
                            
                            <!-- Action Type Selector -->
                            <TextBlock Text="Action Type" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedMapping.ActionType}" Margin="0,0,0,12"/>
                            
                            <!-- 1. KEYSTROKE ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Keystroke">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Modifiers" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="Ctrl" IsChecked="{Binding SelectedMapping.IsCtrl}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Shift" IsChecked="{Binding SelectedMapping.IsShift}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Alt" IsChecked="{Binding SelectedMapping.IsAlt}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Win" IsChecked="{Binding SelectedMapping.IsWin}"/>
                                </WrapPanel>

                                <TextBlock Text="Target Key" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedMapping.TargetKey}" 
                                          IsEditable="True" Text="{Binding SelectedMapping.TargetKey, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- 2. TEXT TYPE ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Text">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Text to Type" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.TextValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Margin="0,0,0,10"/>

                                <TextBlock Text="Delay Between Characters (ms)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.CharDelayMs}" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- 3. LAUNCH ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Launch">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Target (App / File Path / URL)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.LaunchTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="Arguments (Optional)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.LaunchArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <CheckBox Content="Run as Administrator" IsChecked="{Binding SelectedMapping.RunAsAdmin}" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- 4. MEDIA ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Media">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Media Command" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding MediaCommands}" SelectedItem="{Binding SelectedMapping.MediaCommand}" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- 5. MACRO ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Macro">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Macro Name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.SelectedMacroName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- 6. WEB ACTION FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="Web">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Target URL Pattern" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedMapping.WebUrlMatch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="Browser Click Steps" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Button Content="🔴 Record from Browser" Command="{Binding StartRecordWebCommand}" 
                                                Visibility="{Binding IsRecordingWeb, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"/>
                                        <Button Content="⏹ Stop Recording" Command="{Binding StopRecordWebCommand}" 
                                                Visibility="{Binding IsRecordingWeb, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource DangerButton}" Padding="8,4" Margin="0,0,6,0"/>
                                        <Button Content="Clear Steps" Command="{Binding ClearWebStepsCommand}" 
                                                Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Content="▶ Test in Browser" Command="{Binding TestWebActionCommand}" 
                                            Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                                </Grid>

                                <TextBlock Text="{Binding WebRecordStatusText}" Foreground="{DynamicResource PrimaryAccentBrush}" 
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <ListBox ItemsSource="{Binding SelectedMapping.WebSteps}" MinHeight="90" MaxHeight="180" 
                                         BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" 
                                         Background="{DynamicResource CardBrush}" Margin="0,0,0,12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🖱" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Selector}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DelayMs, StringFormat='{}+{0}ms'}" FontSize="10" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- 7. GOOGLE DOCS HIGHLIGHT FORM -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMapping.ActionType}" Value="GoogleDocsHighlight">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Info banner -->
                                <Border Background="#1A4ECDC4" BorderBrush="{DynamicResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🎨 Google Docs Highlight" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run>Applies your exact highlight color via the Lionfish Companion Extension. If the extension is not active, cleanly applies the active toolbar color via Google Docs search menu.</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Highlight Color" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding HighlightColors}" SelectedItem="{Binding SelectedMapping.GoogleDocsHighlightColor}" Margin="0,0,0,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#888888"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="None">    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#888"/><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Yellow">  <Setter Property="Background" Value="#FFFF00"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Green">   <Setter Property="Background" Value="#86EFAC"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Cyan">    <Setter Property="Background" Value="#67E8F9"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Magenta"> <Setter Property="Background" Value="#F0ABFC"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Orange">  <Setter Property="Background" Value="#FDBA74"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Purple">  <Setter Property="Background" Value="#C084FC"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Red">     <Setter Property="Background" Value="#FCA5A5"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="Blue">    <Setter Property="Background" Value="#93C5FD"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Tips card -->
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="💡 Usage Tips" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3">• Select text first, then press your keypad button.</TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3">• If wrong color applies, try increasing keystroke delay (see SequenceAction in profile JSON).</TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">• For instant highlight: set a custom shortcut in Google Docs (Tools → Keyboard Shortcuts) and use Keystroke type.</TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Remove" Command="{Binding RemoveMappingCommand}" CommandParameter="{Binding SelectedMapping}" Style="{StaticResource DangerButton}"/>
                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                        <Button Grid.Column="3" Content="Save Action" Command="{Binding SaveMappingCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Grid>
</UserControl>
