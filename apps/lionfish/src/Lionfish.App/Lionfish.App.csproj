<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lionfish.App</RootNamespace>
    <AssemblyName>Lionfish</AssemblyName>
    <Description>Lionfish — USB Keypad Macro Interceptor</Description>
    <!-- Windows 10 1607+ compatibility -->
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="InputInterceptor" Version="*" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="*" />
  </ItemGroup>

</Project>
