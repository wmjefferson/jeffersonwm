JEFFERSONWM_PORT=8110
JEFFERSONWM_ALLOWED_ORIGIN=http://localhost:5173,https://jeffersonwm.com,https://www.jeffersonwm.com
JEFFERSONWM_DEV_USERNAME=jefferson
JEFFERSONWM_DEV_DISPLAY_NAME=jefferson
JEFFERSONWM_AUTH_BASE_URL=https://auth.jeffersonwm.com
GEOAPIFY_API_KEY=

# Frontend widget switch. Keep false in production until the JeffersonWM API is live.
VITE_WIDGET_ENABLED=false
VITE_WIDGET_API_BASE=/api/widget
VITE_WIDGET_API_PROXY=http://JEFFERSHIZZLE-D:8110

# Add this only when you want to allow widget date/font edits.
# Requests must send it as the x-widget-admin-token header.
JEFFERSONWM_WIDGET_ADMIN_TOKEN=

# JeffersonWM-owned widget database.
# In cPanel this should be created as jeffers4_jeffwm_widget.
JEFFERSONWM_WIDGET_DB_HOST=
JEFFERSONWM_WIDGET_DB_PORT=3306
JEFFERSONWM_WIDGET_DB_USER=
JEFFERSONWM_WIDGET_DB_PASSWORD=
JEFFERSONWM_WIDGET_DB_NAME=jeffers4_jeffwm_widget
