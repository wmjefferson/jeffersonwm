{
  "name": "jeffersonwm",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run server",
    "server": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:JEFFERSONWM_PORT='8110'; $env:JEFFERSONWM_ALLOWED_ORIGIN='http://localhost:5173,https://jeffersonwm.com,https://www.jeffersonwm.com'; tsx server.ts\"",
    "build": "tsc -b && vite build",
    "buildlog": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm",
    "buildlog:jeffersonwm": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm",
    "buildlog:jeffwm": "node ..\\..\\scripts\\logged-build.mjs --app jeffwm",
    "logged-build": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm",
    "publish": "node ..\\..\\scripts\\publish-aso.mjs --app jeffersonwm",
    "publish:jeffersonwm": "node ..\\..\\scripts\\publish-aso.mjs --app jeffersonwm",
    "publish:jeffwm": "node ..\\..\\scripts\\publish-aso.mjs --app jeffwm",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type patch",
    "version:patch:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type patch",
    "version:patch:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type patch",
    "version:minor": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type minor",
    "version:minor:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type minor",
    "version:minor:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type minor",
    "version:major": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type major",
    "version:major:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type major",
    "version:major:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type major",
    "versions": "node ..\\..\\scripts\\versions.mjs",
    "jeffvers": "node ..\\..\\scripts\\versions.mjs",
    "jeffvers:log": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm",
    "jeffvers:jeffersonwm": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm",
    "jeffvers:jeffwm": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm",
    "lint": "eslint .",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
