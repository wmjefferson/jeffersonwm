{
  "name": "jeffersonwm",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run server",
    "server": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:JEFFERSONWM_PORT='8110'; $env:JEFFERSONWM_ALLOWED_ORIGIN='http://localhost:5173,https://jeffersonwm.com,https://www.jeffersonwm.com'; tsx server.ts\"",
    "build": "tsc -b && vite build && node ..\\..\\scripts\\finish-stamp.mjs --label \"build\"",
    "build:publish": "tsc -b && vite build && node ..\\..\\scripts\\publish-aso.mjs --app jeffersonwm --skip-build && node ..\\..\\scripts\\finish-stamp.mjs --label \"build:publish\"",
    "buildlog": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog\"",
    "buildlog:jeffersonwm": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog:jeffersonwm\"",
    "buildlog:jeffwm": "node ..\\..\\scripts\\logged-build.mjs --app jeffwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"buildlog:jeffwm\"",
    "logged-build": "node ..\\..\\scripts\\logged-build.mjs --app jeffersonwm",
    "publish": "node ..\\..\\scripts\\publish-aso.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish\"",
    "publish:jeffersonwm": "node ..\\..\\scripts\\publish-aso.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish:jeffersonwm\"",
    "publish:jeffwm": "node ..\\..\\scripts\\publish-aso.mjs --app jeffwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"publish:jeffwm\"",
    "version": "node -e \"console.log('Use npm run version:patch, npm run version:minor, or npm run version:major')\"",
    "version:patch": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch\"",
    "version:patch:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch:jeffersonwm\"",
    "version:patch:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type patch && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:patch:jeffwm\"",
    "version:minor": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor\"",
    "version:minor:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor:jeffersonwm\"",
    "version:minor:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type minor && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:minor:jeffwm\"",
    "version:major": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major\"",
    "version:major:jeffersonwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffersonwm --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major:jeffersonwm\"",
    "version:major:jeffwm": "node ..\\..\\scripts\\version-and-log.mjs --app jeffwm --type major && node ..\\..\\scripts\\finish-stamp.mjs --label \"version:major:jeffwm\"",
    "versions": "node ..\\..\\scripts\\versions.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"versions\"",
    "jeffvers": "node ..\\..\\scripts\\versions.mjs && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers\"",
    "jeffvers:log": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:log\"",
    "jeffvers:jeffersonwm": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:jeffersonwm\"",
    "jeffvers:jeffwm": "node ..\\..\\scripts\\version-log.mjs --app jeffersonwm && node ..\\..\\scripts\\finish-stamp.mjs --label \"jeffvers:jeffwm\"",
    "fonts": "node ..\\..\\scripts\\list-fonts.mjs --alpha && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts\"",
    "fonts:alpha": "node ..\\..\\scripts\\list-fonts.mjs --alpha && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:alpha\"",
    "fonts:prob": "node ..\\..\\scripts\\list-fonts.mjs --prob && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:prob\"",
    "fonts:round": "node ..\\..\\scripts\\list-fonts.mjs --round-sort && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:round\"",
    "fonts:r1": "node ..\\..\\scripts\\list-fonts.mjs 1 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r1\"",
    "fonts:r2": "node ..\\..\\scripts\\list-fonts.mjs 2 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r2\"",
    "fonts:r3": "node ..\\..\\scripts\\list-fonts.mjs 3 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r3\"",
    "fonts:r4": "node ..\\..\\scripts\\list-fonts.mjs 4 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r4\"",
    "fonts:r5": "node ..\\..\\scripts\\list-fonts.mjs 5 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r5\"",
    "fonts:r6": "node ..\\..\\scripts\\list-fonts.mjs 6 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r6\"",
    "fonts:r7": "node ..\\..\\scripts\\list-fonts.mjs 7 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r7\"",
    "fonts:r8": "node ..\\..\\scripts\\list-fonts.mjs 8 && node ..\\..\\scripts\\finish-stamp.mjs --label \"fonts:r8\"",
    "lint": "eslint . && node ..\\..\\scripts\\finish-stamp.mjs --label \"lint\"",
    "typecheck:api": "tsc -p tsconfig.server.json && node ..\\..\\scripts\\finish-stamp.mjs --label \"typecheck:api\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
