Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Shared under-construction page
RewriteRule ^underconstruction/?$ /underconstruction.html [L]

# Paused public apps
RewriteRule ^bull(/.*)?$ /underconstruction?site=bullion [R=302,L]
RewriteRule ^bullion(/.*)?$ /underconstruction?site=bullion [R=302,L]
RewriteRule ^clio(/.*)?$ /underconstruction?site=clionidae [R=302,L]
RewriteRule ^clionidae(/.*)?$ /underconstruction?site=clionidae [R=302,L]
RewriteRule ^mill(/.*)?$ /underconstruction?site=millionfold [R=302,L]
RewriteRule ^millionfold(/.*)?$ /underconstruction?site=millionfold [R=302,L]
RewriteRule ^verm(/.*)?$ /underconstruction?site=vermilion [R=302,L]
RewriteRule ^vermilion(/.*)?$ /underconstruction?site=vermilion [R=302,L]

# Redirect 4-character short URLs to perihelion share page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9]{4})/?$ /perihelion/?share=$1 [R=302,L]

# Redirect root to /jeffersonwm (landing page)
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(.*)$ /jeffersonwm/ [L]

# JeffersonWM status page
RewriteCond %{THE_REQUEST} \s/+account/index(\.html)?[\s?]
RewriteRule ^account/index(\.html)?$ /account/ [R=301,L]
RewriteRule ^account/?$ /account/index.html [L]

# JeffersonWM project activity page
RewriteCond %{THE_REQUEST} \s/+project-activity/index(\.html)?[\s?]
RewriteRule ^project-activity/index(\.html)?$ /project-activity/ [R=301,L]
RewriteRule ^project-activity/?$ /project-activity/index.html [L]

# JeffersonWM status page
RewriteCond %{THE_REQUEST} \s/+status/index(\.html)?[\s?]
RewriteRule ^status/index(\.html)?$ /status/ [R=301,L]
RewriteRule ^status/?$ /status/index.html [L]

# JeffersonWM development inventory page
RewriteCond %{THE_REQUEST} \s/+development/index(\.html)?[\s?]
RewriteRule ^development/index(\.html)?$ /development/ [R=301,L]
RewriteRule ^development/?$ /development/index.html [L]

# Jeffersonwm landing page SPA routing (if needed)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^jeffersonwm(/.*)?$ /jeffersonwm/index.html [L]

# Lionship app routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^lionship(/.*)?$ /lionship/index.html [L]

# Battalion app routing split
# 1. Landing page paused; send battalion root straight to /home
# RewriteCond %{REQUEST_URI} ^/battalion/?$
# RewriteRule ^(.*)$ /battalion/landing.html [L]
RewriteCond %{REQUEST_URI} ^/battalion/?$
RewriteRule ^battalion/?$ /battalion/home [R=302,L]

# 2. Rewrite /battalion/home to index.html (the SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^battalion/home(/.*)?$ /battalion/index.html [L]

# 3. Rewrite any other battalion paths (deep links) to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^battalion(/.*)?$ /battalion/index.html [L]

# Perihelion app routing split
# 1. Redirect if a share query parameter is present (to bypass landing page)
RewriteCond %{QUERY_STRING} share=([a-zA-Z0-9]{4})
RewriteRule ^perihelion/?$ /perihelion/home [QSA,L,R=302]

# 2. Landing page paused; send perihelion root straight to /home
# RewriteCond %{REQUEST_URI} ^/perihelion/?$
# RewriteRule ^(.*)$ /perihelion/landing.html [L]
RewriteCond %{REQUEST_URI} ^/perihelion/?$
RewriteRule ^perihelion/?$ /perihelion/home [R=302,L]

# 3. Rewrite /perihelion/home to index.html (the SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^perihelion/home(/.*)?$ /perihelion/index.html [L]

# 4. Rewrite any other perihelion paths (deep links) to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^perihelion(/.*)?$ /perihelion/index.html [L]

# Serve assets directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
